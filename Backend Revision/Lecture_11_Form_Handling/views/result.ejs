<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Form Result</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body class="result-body">
  <div class="result-container">
    <h1 class="result-title">✅ Form Data Submitted Successfully</h1>
    <div class="result-card">
      <p><strong>Name:</strong> <span class="result-value"><%= name %></span></p>
      <p><strong>Email:</strong> <span class="result-value"><%= email %></span></p>
    </div>
    <a href="/" class="back-btn">⬅ Go Back</a>
  </div>
</body>
</html>
