<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/style.css" />
  <title>All Users</title>
</head>
<body class="result-body">
  <div class="result-container">
    <h1>👥 All Registered Users</h1>

    <% if (users.length === 0) { %>
      <p>No users registered yet.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Name</th>
            <th>Email</th>
            <th>Password</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach((user, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= user.name %></td>
              <td><%= user.email %></td>
              <td><%= user.password %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <a href="/" class="btn-2">⬅ Add New User</a>
  </div>
</body>
</html>
